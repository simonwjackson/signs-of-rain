; Standalone authored prototype. No original BW2 content.
config_version=5

[application]
config/name="Signs of Rain"
config/use_custom_user_dir=true
config/custom_user_dir_name="signs-of-rain"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/description="You choose the act. They decide what it means."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=320
window/size/min_height=240
window/stretch/mode="disabled"
window/stretch/scale_mode="fractional"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.071, 0.153, 0.153, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=false

[debug]
gdscript/warnings/inference_on_variant=0
